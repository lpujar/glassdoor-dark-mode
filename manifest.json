{
  "manifest_version": 3,
  "name": "Glassdoor Dark Mode",
  "version": "1.1.0",
  "description": "Dark mode for Glassdoor with a toggle, shortcut, system theme and schedule. Unofficial, not affiliated with Glassdoor.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Glassdoor Dark Mode",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "toggle-dark-mode": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Toggle dark mode on Glassdoor"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.glassdoor.com/*",
        "https://*.glassdoor.co.in/*",
        "https://*.glassdoor.co.uk/*"
      ],
      "css": ["src/content.css"],
      "js": ["src/logic.js", "src/content.js"],
      "run_at": "document_start"
    }
  ]
}
